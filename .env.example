# Copy this file to .env (same folder) and fill in your real values.
# .env is gitignored - it never leaves your machine.

# From https://console.twilio.com (API credentials)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# The Twilio number that places the call
TWILIO_FROM_NUMBER=+1606xxxxxxx

# Your own phone for the test call
TEST_TO_NUMBER=+91xxxxxxxxxx

# Where Twilio should send the call flow.
# Local backend via ngrok:  https://your-tunnel.ngrok-free.app/webhook/doctor-bot
# n8n Cloud:                https://your-instance.app.n8n.cloud/webhook/doctor-bot
WEBHOOK_URL=https://your-n8n-domain/webhook/doctor-bot
